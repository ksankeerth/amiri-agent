# Copy to terraform.tfvars (git ignores it) and fill in. No secrets here: infra/scripts/secrets.sh puts them
# in Secret Manager.

project_id     = "your-project-id"
region         = "asia-south1"
operator_email = "you@gmail.com"

# The reCAPTCHA v2 ("I'm not a robot" checkbox) site key for the server's hostname
# (`terraform output server_hostname`). Its secret key goes in with infra/scripts/secrets.sh.
recaptcha_site_key = ""

# A monthly budget alert (optional): your billing account id, from `gcloud billing accounts list`.
billing_account_id = ""
budget_amount      = 20

# Optional: extra server settings (server/.env.example), for example Radar's daily model calls.
# server_env = { SERIES_MAX = "6", RADAR_MODEL_CALLS_PER_DAY = "300" }

# `awake` is set by infra/scripts/awake.sh (awake.auto.tfvars); `image_tag` by build.sh (image.auto.tfvars).

prototype_reset = true