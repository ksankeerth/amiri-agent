# Configuration for amiri-server. Copy to .env and change what you need.
# Every setting is optional: uncomment a line to change it. The value shown
# is the default (app/settings.py). Real environment variables win over .env.

# Port of `uv run amiri serve`.
# SERVER_PORT=8000

# text (local) or json (Cloud Run: severity, one entry per traceback, linked to
# the request's trace).
# LOG_FORMAT=text

# Lowest level logged: DEBUG, INFO, WARNING or ERROR.
# LOG_LEVEL=INFO

# The Google Cloud project; with LOG_FORMAT=json it links each log line to its
# request's trace.
# GOOGLE_CLOUD_PROJECT=

# Keeping bots out: off (no check; local runs and tests) or prototype (no login,
# just a Google reCAPTCHA box to tick, then a cookie; the public URL).
# AUTH_MODE=off

# reCAPTCHA v2 checkbox site key (public; shown to the browser). Local test key:
# 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI (always passes, shows a test banner).
# RECAPTCHA_SITE_KEY=

# reCAPTCHA secret key, checked by the server (local test secret:
# 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe).
# RECAPTCHA_SECRET=

# Where the server checks a reCAPTCHA token.
# RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify

# Comma-separated hostnames a token must be issued for (the public URL's host);
# empty: not checked.
# RECAPTCHA_HOSTNAMES=

# Signs session cookies (32+ random characters). Changing it signs everyone out.
# SESSION_SECRET=

# How long a passed check lasts; then the box shows again.
# SESSION_HOURS=12

# Checks per IP address per minute.
# LOGIN_PER_MINUTE=10

# reCAPTCHA checks one server instance makes a day at most (the free allowance
# is 10,000 a month for the whole organisation).
# LOGIN_CHECKS_PER_DAY=1000

# With the bot check on, agents on this machine (loopback, no proxy) skip it:
# local runs only, never true on Cloud Run.
# AUTH_LOCAL_AGENTS=true

# Refuse requests from AI crawlers and simple scripts that name themselves
# (GPTBot, ClaudeBot, PerplexityBot, CCBot, HeadlessChrome, …); robots.txt asks
# every bot to stay away.
# BLOCK_AI_CRAWLERS=true

# Comma-separated origins allowed to call the API from a browser (a web app
# served from another port during development). Empty: none.
# CORS_ORIGINS=http://localhost:5173

# The built web app (npm run build in web/), served at / when it exists
# (relative to the server folder).
# WEB_DIST=../web/dist

# The institution this installation serves (one installation per institution).
# INSTITUTION_ID=bank-a

# Postgres connection string (the compose.yaml database locally; AlloyDB or
# Cloud SQL in Google Cloud).
# DATABASE_URL=postgresql://amiri:amiri@localhost:5432/amiri

# Database the tests wipe and rebuild. Never point it at real data.
# TEST_DATABASE_URL=postgresql://amiri:amiri@localhost:5432/amiri_test

# Most database connections the server holds.
# DB_POOL_MAX=10

# Seconds to wait for the database when checking whether it is up.
# DB_CONNECT_TIMEOUT_SECONDS=5

# While the database is stopped (asleep), how often a request may try it again;
# once it answers the server wakes without a restart.
# DB_WAKE_PROBE_SECONDS=15

# Apply pending migrations when the server starts.
# AUTO_MIGRATE=true

# Twelve Data API key. Without it, the series pages still work, but adding,
# refreshing and the hourly fetch return provider_not_configured.
# TWELVEDATA_API_KEY=

# Twelve Data API base.
# TWELVEDATA_BASE_URL=https://api.twelvedata.com

# The Twelve Data plan of the key (Basic is the free plan; then Grow, Pro,
# Ultra, Enterprise). Search results above it can't be added.
# TWELVEDATA_PLAN=Basic

# Seconds Twelve Data gets to answer one call.
# TWELVEDATA_TIMEOUT_SECONDS=15

# API credits Amiri Agent may spend in any 60 seconds (the free plan allows 8).
# Scheduled fetches over it wait for the next tick; manual refreshes and adds
# get 429 with Retry-After.
# TWELVEDATA_CREDITS_PER_MINUTE=8

# API credits Amiri Agent may spend per UTC day (the free plan allows 800).
# TWELVEDATA_CREDITS_PER_DAY=800

# Where chat messages go. none: not connected (replies say so; forms still
# work). stub: canned replies and keyword routing in-process, for UI work. http:
# the setup agent service at ASSISTANT_URL through the contract
# (app/assistant/contract.py): the real amiri-setup-agent, or `uv run amiri
# fake-agent`.
# ASSISTANT_BACKEND=none

# Base URL of the setup agent service (http backend).
# ASSISTANT_URL=http://localhost:8003

# How the server calls the agent: none (local), or id_token (a Google ID token
# for ASSISTANT_URL, on Cloud Run).
# ASSISTANT_AUTH=none

# The server's URL as the agent reaches it, for its tools (sent to the agent
# with each session).
# SERVER_PUBLIC_URL=http://localhost:8000

# Longest one assistant turn may take.
# ASSISTANT_TIMEOUT_SECONDS=120

# A chat session ends after this long without a message; the next message starts
# a new one with a fresh context pack (the chat history stays).
# ASSISTANT_SESSION_IDLE_MINUTES=30

# Messages one person may send to the setup agent in any minute (cost and abuse
# control).
# ASSISTANT_TURNS_PER_MINUTE=6

# Messages one person may send per UTC day.
# ASSISTANT_TURNS_PER_DAY=300

# A proposal not confirmed within this many hours expires.
# ASSISTANT_PROPOSAL_TTL_HOURS=24

# The investigation agent (agents/investigation-agent; locally
# http://localhost:8001). Empty: not connected; new findings wait.
# INVESTIGATION_URL=

# How the server calls the investigation agent: none (local), or id_token (Cloud
# Run).
# INVESTIGATION_AUTH=none

# A new finding waits this long for related ones before its batch is
# investigated (Investigate now skips the wait).
# INVESTIGATION_WAIT_MINUTES=10

# A batch whose run fails is sent again this many times in all; then its
# findings are set aside.
# INVESTIGATION_MAX_ATTEMPTS=3

# Who may call /api/v1/internal/* (what the agents read): none (local), or
# id_token (a Google ID token for SERVER_PUBLIC_URL from a service account in
# INTERNAL_CALLERS; Cloud Run).
# INTERNAL_AUTH=none

# Comma-separated service-account emails allowed on /api/v1/internal/* when
# INTERNAL_AUTH=id_token (the investigation agent's).
# INTERNAL_CALLERS=

# An event stays open this many days after its last finding; a new finding about
# the same move joins it as a development meanwhile, then it closes.
# EVENT_OPEN_DAYS=14

# on: the investigation builds validation tasks against the institution's
# metrics. off: it stops at hypotheses and a readable investigation.
# METRICS_VALIDATION=off

# The monitor agent (agents/event-monitor-agent; locally http://localhost:8002).
# Empty: not connected; live monitors wait.
# MONITOR_URL=

# How the server calls the monitor agent: none (local), or id_token (Cloud Run).
# MONITOR_AUTH=none

# Live monitors at most (each check is a model and web search cost).
# MONITORS_LIVE_MAX=10

# The most often a monitor may be checked: 15, 60, 360 or 1440.
# MONITOR_MIN_FREQUENCY_MINUTES=60

# Allow the prototype reset (wipes the institution and all Amiri Agent made for
# it; keeps market prices and reference data). Switch off for a real deployment.
# PROTOTYPE_RESET=true

# The region the prototype is tested for: an institution's home country and base
# currency must be in it (app/reference/regions.json). Empty: anywhere.
# SUPPORTED_REGION=japac

# One institution per platform (a deployment serves one bank or insurer); a
# second can't be created until the prototype is reset.
# SINGLE_INSTITUTION=true

# After a check fails, try again this many minutes later (not the whole
# frequency): a failed check read nothing and moved no window, so retrying early
# loses nothing.
# MONITOR_RETRY_MINUTES=60

# Checks started per tick at most; the rest wait for the next tick.
# MONITOR_CHECKS_PER_TICK=5

# A monitor's first check reads news this far back.
# MONITOR_FIRST_LOOKBACK_HOURS=24

# Web searches one check may run.
# MONITOR_WEB_QUERIES_PER_CHECK=3

# Pages a monitor reported in this many days are not reported again.
# MONITOR_RECENT_DAYS=7

# When an agent doesn't answer a new run in time (Cloud Run starting it from
# zero), the run is sent again once, waiting this long.
# AGENT_COLD_START_TIMEOUT_SECONDS=120

# Base URL of the Radar agent (agents/radar-agent); empty: not connected.
# RADAR_URL=

# How the server calls the Radar agent: none (local) or id_token (Cloud Run).
# RADAR_AUTH=none

# Minutes between scheduled Radar runs (Check now runs one at once).
# RADAR_EVERY_MINUTES=60

# The first run reads this many hours back.
# RADAR_FIRST_LOOKBACK_HOURS=24

# Stories reported in this many days are sent as seen (for developments).
# RADAR_SEEN_DAYS=14

# Stories a run may return at most.
# RADAR_MAX_STORIES=10

# Model calls a run may make at most.
# RADAR_MAX_MODEL_CALLS=40

# Longest a run may take inside the agent.
# RADAR_TIMEOUT_SECONDS=300

# BigQuery queries a run may make at most.
# RADAR_MAX_QUERIES=3

# BigQuery maximum_bytes_billed for each query (bytes).
# RADAR_MAX_BYTES_PER_QUERY=2000000000

# BigQuery bytes Radar may scan per UTC day; scheduled runs are skipped once it
# is spent (bytes).
# RADAR_DAILY_BYTES_CAP=50000000000

# Steps a simulation waits before its first investigation, so a story's first
# findings go in together.
# SIM_INVESTIGATION_WAIT_STEPS=2

# Real seconds a simulation waits for one agent run before it gives up on it and
# moves on.
# SIM_AGENT_DEADLINE_SECONDS=480

# Times a simulation's investigation is tried (the first try and one retry).
# SIM_MAX_ATTEMPTS=2

# Most series one installation may watch (prototype limit; paused series count).
# SERIES_MAX=8

# How often each series is fetched. Fetches are due on the hour (for 60), and
# run on the first tick at or after that time.
# SERIES_FETCH_EVERY_MINUTES=60

# Least time between two manual refreshes of one series.
# SERIES_REFRESH_COOLDOWN_SECONDS=120

# Hourly bars read when a series is added (60 trading days need about 1,440 for
# a 24-hour market). One call, at most 5000.
# SERIES_BACKFILL_BARS=2000

# A fetch that hasn't finished after this long (a crashed instance) no longer
# blocks the next one.
# SERIES_FETCH_LEASE_SECONDS=300

# A move fires at |z| at or above this.
# SERIES_Z_THRESHOLD=3

# Trading days of daily moves that set a series' typical daily move.
# SERIES_SIGMA_DAYS=60

# Fewer daily moves than this: the series is warming up and nothing fires.
# SERIES_MIN_SIGMA_DAYS=20

# Move lengths checked, in trading days.
# SERIES_WINDOWS_DAYS=1,3,5

# After a series fires, it stays quiet this long.
# SERIES_COOLDOWN_HOURS=24

# Default for markets that trade around the clock on weekdays (currencies,
# metals, crypto): no new bar for this many weekday hours means stale.
# SERIES_STALE_AFTER_HOURS_24H=6

# Default for markets with daily sessions (shares, funds, indices).
# SERIES_STALE_AFTER_HOURS_SESSION=30

