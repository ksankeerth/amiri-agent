    "public": {
      "watch": [
        {
          "name": "Earthquake in Indonesia",
          "type": "topic"
        },
        {
          "name": "Volcanic eruption in Indonesia",
          "type": "topic"
        },
        {
          "name": "Jakarta floods",
          "type": "topic"
        },
