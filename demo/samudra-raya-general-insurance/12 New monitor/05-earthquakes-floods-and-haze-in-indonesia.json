            "kabut asap"
          ]
        }
      ],
      "in_one_sentence": "Natural disasters in Indonesia that could produce claims or health and crop losses.",
      "tell_me_if": [
        "An earthquake of magnitude 5.5 or more strikes Java, Sumatra, Sulawesi or near a major city, or a tsunami warning is issued",
        "A volcano erupts, closes airports or forces evacuations",
        "Floods hit Jakarta, Surabaya, Medan or an industrial estate, or the BMKG warns of extreme weather",
        "Haze from Sumatra or Kalimantan fires reaches hazardous levels or closes airports"
      ],
      "ignore": [
        "Minor tremors with no damage",
        "Seasonal forecasts with no warning"
      ],
      "example_headlines": {
        "match": [
          {
            "headline": "Magnitude 6.1 earthquake strikes West Java, buildings damaged",
            "line": 1
          },
          {
            "headline": "Floods inundate Jakarta suburbs and industrial estates",
            "line": 3
          },
          {
            "headline": "Haze closes airports in Riau",
            "line": 4
          }
        ],
        "not_match": [
          "Disaster preparedness workshop held"
        ]
      },
      "places": [
        "ID",
        "ID-JK",
        "ID-JB",
        "ID-RI",
        "ID-KT",
        "ID-SU"
      ],
      "languages": [
        "en"
      ],
      "sources": {
        "mode": "any_reputable",
        "check_first": [
          "BMKG",
          "BNPB",
          "Jakarta Post"
        ]
      }
    },
    "private": {
