# Configuration for the event monitor agent. Copy to .env and change what you need.
# Every setting below is optional: uncomment a line to change it. The value shown
# is the default (app/settings.py). Real environment variables win over .env.

# ---- Credentials (pick one) ----------------------------------------------------

# Gemini API via Google AI Studio:
# GEMINI_API_KEY=your-api-key-here

# Or Vertex AI (the default for deployment):
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# ---- Models ----------------------------------------------------------------
# Each list is tried in order. A busy, slow or out-of-quota model hands the
# call to the next, and each model has its own quota.

# Models for the agent's steps.
# AGENT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Models that review every finding: stronger first.
# REVIEWER_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# Models for web search (Google Search grounding). Needs a key whose plan
# allows search grounding: the AI Studio free tier gives Gemini 3 none, and
# Gemini 2.5 is closed to new users. Without it, web_search fails and a check
# can find nothing (Vertex AI or billing on the key's project is needed).
# SEARCH_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Sampling temperature for the agent.
# AGENT_TEMPERATURE=0.2

# ---- Reliability -----------------------------------------------------------

# Seconds an agent model gets for one call before the next model is tried.
# MODEL_CALL_TIMEOUT_SECONDS=90

# Seconds a reviewer model gets before the next is tried.
# REVIEWER_TIMEOUT_SECONDS=20

# Seconds a search model gets before the next is tried.
# SEARCH_TIMEOUT_SECONDS=30

# Seconds a failed model is skipped. A quota error that says when to retry
# (e.g. a daily cap) is skipped until then instead.
# MODEL_COOLDOWN_SECONDS=60

# ---- Cited pages -----------------------------------------------------------

# Seconds to read a cited page's date and title.
# PAGE_TIMEOUT_SECONDS=6

# Bytes read from a cited page at most (its head is enough).
# PAGE_MAX_BYTES=600000

# A cited page published this many hours before the check's window still
# counts (search finds news late); the monitor's already-reported pages are
# never reported again.
# PAGE_DATE_GRACE_HOURS=24

# ---- Server ----------------------------------------------------------------

# Where check runs are kept (relative to the project).
# RUNS_DB_PATH=data/runs.db

# Checks run at once per server; more wait as queued.
# MAX_CONCURRENT_CHECKS=4

# Comma-separated CORS origins for the API; empty = none.
# ALLOW_ORIGINS=

# text (local) or json (Cloud Run: severity, one entry per traceback, linked to
# the run's trace; app/logs.py).
# LOG_FORMAT=text

# Lowest level logged: DEBUG, INFO, WARNING or ERROR.
# LOG_LEVEL=INFO

# true/false: export traces to Cloud Trace (needs Google Cloud credentials).
# Empty = on only on Cloud Run.
# OTEL_TO_CLOUD=

# ---- Development only (never set in production) ----------------------------

# Development only: seconds between model requests for a rate-limited key
# (devtools/pacing.py, not in the image). Empty = no waiting.
# MODEL_MIN_INTERVAL_SECONDS=
