# Configuration for the Radar agent. Copy to .env and change what you need.
# Every setting below is optional: uncomment a line to change it. The value shown
# is the default (app/settings.py). Real environment variables win over .env.

# ---- Credentials (pick one) ----------------------------------------------------

# Gemini API via Google AI Studio:
# GEMINI_API_KEY=your-api-key-here

# Or Vertex AI (the default for deployment):
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# BigQuery uses Google Cloud credentials: `gcloud auth application-default login`
# locally, the service account (roles/bigquery.jobUser) on Cloud Run.

# ---- Judge model -----------------------------------------------------------------

# Tried in order. A busy, slow or out-of-quota model hands the call to the next,
# and each model has its own quota.

# Models that judge stories, tried in order.
# AGENT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Sampling temperature for the judge.
# AGENT_TEMPERATURE=0.2

# Seconds a model gets for one call before the next is tried.
# MODEL_CALL_TIMEOUT_SECONDS=90

# Seconds a failed model is skipped.
# MODEL_COOLDOWN_SECONDS=60

# Stories per model call.
# JUDGE_BATCH_SIZE=5

# The model judges at most this many times max_stories (the best by score).
# SHORTLIST_FACTOR=3

# Cost guard: model calls a day (UTC) at most; over it, stories are reported
# from code scoring alone, held back (send false).
# MODEL_CALLS_PER_DAY=300

# ---- BigQuery (GDELT 2.0) --------------------------------------------------------

# One query a run, on the partitioned GKG table only, at most 2 days. Each query
# is dry-run first and capped with maximum_bytes_billed; the agent also adds up
# what its own jobs billed today and this month and refuses to go over.

# The project that runs and pays for the queries; empty: GOOGLE_CLOUD_PROJECT.
# BQ_PROJECT=

# Where GDELT's dataset lives.
# BQ_LOCATION=US

# Articles a query returns at most, newest first (returned rows cost nothing;
# this bounds memory). A day for one bank was about 1,000 after the query's
# rules.
# BQ_ROW_LIMIT=10000

# Cost guard: maximum_bytes_billed for a query; the request's limit applies
# too, the lower wins (bytes).
# BQ_MAX_BYTES_PER_QUERY=1500000000

# Cost guard: bytes this agent's own BigQuery jobs may bill a day (UTC);
# checked against BigQuery's job list before each query (bytes).
# BQ_DAILY_BYTES=20000000000

# Cost guard: bytes this agent's own jobs may bill a calendar month; below the
# free 1 TiB (bytes).
# BQ_MONTHLY_BYTES=600000000000

# A footprint country counts as what an article is about when it makes up at
# least this share of the article's place mentions (and 2 or more).
# FOOTPRINT_SHARE=0.4

# The home country counts when the article mentions it this many times (or in
# the title).
# HOME_MENTIONS=3

# ---- Stories ---------------------------------------------------------------------

# Stories reported are remembered this long (stable fingerprints,
# developments).
# MEMORY_DAYS=14

# At most this many stories a run are sent for investigation; never a low one.
# SEND_MAX_PER_RUN=3

# ---- Server ----------------------------------------------------------------------

# Runs, memory and the model-call count (SQLite, relative to the project).
# RUNS_DB_PATH=data/runs.db

# Runs worked at once; more wait as queued.
# MAX_CONCURRENT_RUNS=2

# Comma-separated CORS origins for the API; empty = none.
# ALLOW_ORIGINS=

# text (local) or json (Cloud Run; app/logs.py).
# LOG_FORMAT=text

# Lowest level logged: DEBUG, INFO, WARNING or ERROR.
# LOG_LEVEL=INFO

# true/false: export traces to Cloud Trace. Empty = on only on Cloud Run.
# OTEL_TO_CLOUD=
