# Configuration for the investigation agent. Copy to .env and change what you need.
# Every setting below is optional: uncomment a line to change it. The value shown
# is the default (app/settings.py). Real environment variables win over .env.

# ---- Credentials (pick one) ----------------------------------------------------

# Gemini API via Google AI Studio (comment out the three Vertex lines below):
# GEMINI_API_KEY=your-api-key-here

# Or Vertex AI (the default for deployment):
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# ---- Settings ------------------------------------------------------------------

# Models for the classify, screen and choose steps.
# AGENT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Sampling temperature for every step.
# AGENT_TEMPERATURE=0.0

# Seconds a model gets for one step before the next model is tried.
# MODEL_CALL_TIMEOUT_SECONDS=60

# Seconds a failed model is skipped. A quota error that says when to retry
# (e.g. a daily cap) is skipped until then instead.
# MODEL_COOLDOWN_SECONDS=60

# How the agent calls amiri-server's coverage and calendar: none (local), or id_token
# (a Google ID token for the request's server_url; Cloud Run).
# DATA_AUTH=none

# Seconds amiri-server gets to answer a coverage or calendar call.
# DATA_TIMEOUT_SECONDS=20

# Where investigation runs are kept (relative to the project).
# RUNS_DB_PATH=data/runs.db

# Investigations run at once per server; more wait as queued.
# MAX_CONCURRENT_INVESTIGATIONS=2

# Comma-separated CORS origins for the API; empty = none.
# ALLOW_ORIGINS=

# true/false: export traces to Cloud Trace (needs Google Cloud credentials).
# Empty = on only on Cloud Run.
# OTEL_TO_CLOUD=
