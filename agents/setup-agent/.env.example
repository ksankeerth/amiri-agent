# Configuration for the setup agent. Copy to .env and change what you need.
# Every setting below is optional: uncomment a line to change it. The value shown
# is the default (app/settings.py). Real environment variables win over .env.

# ---- Credentials (pick one) ----------------------------------------------------

# Gemini API via Google AI Studio:
# GEMINI_API_KEY=your-api-key-here

# Or Vertex AI (the default for deployment):
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# ---- Settings ------------------------------------------------------------------

# Models for the track agents.
# AGENT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Models for the router (one structured choice of track per message).
# ROUTER_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Sampling temperature for the track agents.
# AGENT_TEMPERATURE=0.2

# Seconds a track agent's model gets for one call before the next model is tried.
# MODEL_CALL_TIMEOUT_SECONDS=60

# Seconds a router model gets before the next is tried. If every router model fails, the
# turn stays in its current track (code).
# ROUTER_TIMEOUT_SECONDS=8

# Seconds a failed model is skipped. A quota error that says when to retry (e.g. a daily
# cap) is skipped until then instead.
# MODEL_COOLDOWN_SECONDS=60

# Longest one turn may take (the server waits ASSISTANT_TIMEOUT_SECONDS, 120); after it
# the turn ends with an error event.
# TURN_TIMEOUT_SECONDS=105

# Model calls a track agent may make in one turn.
# MAX_STEPS_PER_TURN=12

# Times a track may fix and resend a proposal the server refused (422) in one turn.
# MAX_REPAIRS=2

# How the agent calls amiri-server: none (local), or id_token (a Google ID token for the
# session's server_url, on Cloud Run).
# SERVER_AUTH=none

# Seconds one call to amiri-server may take.
# SERVER_TIMEOUT_SECONDS=20

# A session not used for this long is dropped; the server starts a new one (it does
# after 30 minutes idle anyway).
# SESSION_IDLE_HOURS=12

# Comma-separated CORS origins for the API; empty = none.
# ALLOW_ORIGINS=

# text (local) or json (Cloud Run: severity, one entry per traceback, linked to the
# run's trace; app/logs.py).
# LOG_FORMAT=text

# Lowest level logged: DEBUG, INFO, WARNING or ERROR.
# LOG_LEVEL=INFO

# true/false: export traces to Cloud Trace (needs Google Cloud credentials). Empty = on
# only on Cloud Run.
# OTEL_TO_CLOUD=

# Development only: seconds between model requests for a rate-limited key
# (devtools/pacing.py, not in the image). Empty = no waiting.
# MODEL_MIN_INTERVAL_SECONDS=
